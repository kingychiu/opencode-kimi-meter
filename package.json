{
  "name": "opencode-kimi-meter",
  "version": "0.1.6",
  "description": "Kimi Coding subscription quota, plan, and model dashboard for OpenCode V2",
  "license": "MIT",
  "keywords": [
    "opencode",
    "kimi",
    "quota",
    "tui",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingychiu/opencode-kimi-meter.git"
  },
  "homepage": "https://github.com/kingychiu/opencode-kimi-meter#readme",
  "bugs": {
    "url": "https://github.com/kingychiu/opencode-kimi-meter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js",
    "./usage": "./dist/usage.js"
  },
  "scripts": {
    "build": "bun build src/tui.tsx src/usage.ts --outdir dist --target bun --format esm --external @opencode/plugin/tui --external @opentui/core --external @opentui/solid --external @opentui/solid/jsx-runtime --external solid-js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "peerDependencies": {
    "@opentui/core": "0.9.5",
    "@opentui/solid": "0.9.5",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.9.5",
    "@opentui/solid": "0.9.5",
    "@types/node": "^24.0.0",
    "solid-js": ">=1.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
